<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
		
	</PropertyGroup>

	<!-- References -->
	<ItemGroup>
		<!--
			Compile-time-only reference to SubworldLibrary, declared as a strong runtime
			dependency via `modReferences = SubworldLibrary` in build.txt. tModLoader's own
			mod-loading pipeline resolves modReferences at runtime by extracting the referenced
			mod's compiled assembly from its installed .tmod; the plain `dotnet build`/`dotnet
			msbuild` command line does not understand that mechanism, so a local compile-time
			Reference is needed here too. Libs/SubworldLibrary.dll is extracted from the
			installed Workshop copy (not committed, see .gitignore) and never copied into
			this mod's own output (Private=false), since SubworldLibrary is already installed
			and loaded separately by tModLoader at runtime.
		-->
		<Reference Include="SubworldLibrary" Condition="Exists('Libs\SubworldLibrary.dll')">
			<HintPath>Libs\SubworldLibrary.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!--
			Compile-time-only weak reference to CalamityMod, declared as a weak runtime
			dependency via `weakReferences = CalamityMod@2.2.4` in build.txt (per D-01: the
			mod must still load with CalamityMod absent). Libs/CalamityMod.dll is extracted
			from the installed Workshop copy via scripts/extract_tmod.py (not committed,
			see .gitignore) and never copied into this mod's own output (Private=false).
		-->
		<Reference Include="CalamityMod" Condition="Exists('Libs\CalamityMod.dll')">
			<HintPath>Libs\CalamityMod.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>